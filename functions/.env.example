# Copy to functions/.env (gitignored). Set ROUNDPAY_USE_MOCK_PROVIDERS=1 to bypass
# real provider calls and use the in-process MockProvider — useful for local
# development before sandbox keys are wired.

ROUNDPAY_USE_MOCK_PROVIDERS=1
MOCK_PROVIDER_WEBHOOK_SECRET=dev-secret

# ----- MTN MoMo (Open API) -----
# Get these from https://momodeveloper.mtn.com — provision a sandbox API user.
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER_ID=
MTN_MOMO_API_KEY=
MTN_MOMO_CALLBACK_URL=
MTN_MOMO_WEBHOOK_SECRET=
MTN_MOMO_ENV=sandbox

# ----- Airtel Money (Open API) -----
# Get these from https://developers.airtel.africa
AIRTEL_MONEY_BASE_URL=https://openapiuat.airtel.africa
AIRTEL_MONEY_CLIENT_ID=
AIRTEL_MONEY_CLIENT_SECRET=
AIRTEL_MONEY_COUNTRY=UG
AIRTEL_MONEY_CURRENCY=UGX
AIRTEL_MONEY_WEBHOOK_SECRET=
