{
  "name": "functions",
  "version": "0.1.0",
  "private": true,
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "test:rules": "node --test --import tsx 'test/rules/**/*.test.ts'",
    "test:providers": "node --test --import tsx 'test/providers/**/*.test.ts'",
    "test:e2e": "node --test --import tsx 'test/e2e/**/*.test.ts'",
    "test": "npm run test:providers && npm run test:rules && npm run test:e2e"
  },
  "dependencies": {
    "@roundpay/shared": "*",
    "firebase-admin": "^12.1.0",
    "firebase-functions": "^5.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@types/node": "^20.12.7",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": "20"
  }
}
